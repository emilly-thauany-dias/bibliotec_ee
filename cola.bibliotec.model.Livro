[32m+[m[32m@Controller[m
[32m+[m[32m@RequestMapping("/livros")[m
 public class LivroController {[m
[32m+[m
[32m+[m[32m    private final LivroService livroService;[m
[32m+[m[32m    private final CategoriaService categoriaService;[m
[32m+[m
[32m+[m[32m    public LivroController(LivroService livroService, CategoriaService categoriaService) {[m
[32m+[m[32m        this.livroService = livroService;[m
[32m+[m[32m        this.categoriaService = categoriaService;[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    @GetMapping[m
[32m+[m[32m    public String listar(Model model) {[m
[32m+[m[32m        model.addAttribute("livros", livroService.listarTodos());[m
[32m+[m[32m        return "livros/lista";[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    @GetMapping("/novo")[m
[32m+[m[32m    public String novo(Model model) {[m
[32m+[m[32m        Livro livro = new Livro();[m
[32m+[m[32m        livro.setCategoria(new Categoria()); // o select lê categoria.id sem encontrar null[m
[32m+[m[32m        model.addAttribute("livro", livro);[m
[32m+[m[32m        return formulario(model);[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    @PostMapping[m
[32m+[m[32m    public String salvar(@Valid @ModelAttribute("livro") Livro livro,[m
[32m+[m[32m                         BindingResult resultado,[m
[32m+[m[32m                         Model model,[m
[32m+[m[32m                         RedirectAttributes redirectAttributes) {[m
[32m+[m[32m        if (livro.getCategoria() == null || livro.getCategoria().getId() == null) {[m
[32m+[m[32m            resultado.rejectValue("categoria.id", "categoria.obrigatoria",[m
[32m+[m[32m                    "Escolha uma categoria");[m
[32m+[m[32m        }[m
[32m+[m[32m        if (resultado.hasErrors()) {[m
[32m+[m[32m            return formulario(model);[m
[32m+[m[32m        }[m
[32m+[m[32m        livroService.salvar(livro);[m
[32m+[m[32m        redirectAttributes.addFlashAttribute("mensagem", "Livro salvo com sucesso!");[m
[32m+[m[32m        return "redirect:/livros";[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    private String formulario(Model model) {[m
[32m+[m[32m        model.addAttribute("categorias", categoriaService.listarTodas());[m
[32m+[m[32m        return "livros/form";[m
[32m+[m[32m    }[m
 }[m
